  </MAINGROUP>
  <EXPORTFORMATS>
    <!-- javaopt/app fornece com.rmsl.juce.Receiver, que o Projucer registra
         incondicionalmente no Manifest. ChurchDAWActivity NAO herda da
         JuceActivity desse diretorio: sem push, a base correta e Activity. -->
    <ANDROIDSTUDIO targetFolder="Builds/Android"
                   androidActivitySubClassName="com.churchdaw.app.ChurchDAWActivity"
                   androidAdditionalJavaFolders="Source/AndroidJava&#10;JUCE/modules/juce_gui_basics/native/javaopt/app"
                   androidCpp11="1"
                   androidMinimumSDK="24"
                   androidTargetSDK="36"
                   androidVersionCode="14"
                   androidInternetNeeded="1"
                   androidReadMediaAudioPermission="1"
                   androidReadMediaImagesPermission="0"
                   androidReadMediaVideoPermission="0"
                   androidExternalWriteNeeded="0"
                   androidPushNotifications="0"
                   androidScreenOrientation="unspecified"
                   androidTheme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
                   bigIcon="astAnd"
                   smallIcon="astAnd"
                   androidDependencies=""
                   androidCustomAppBuildGradleContent="&#10;    // A distribuicao e feita pelo churchdaw.com. A chave de release fica fora&#10;    // do projeto; sem as credenciais o Gradle nunca assina um APK de producao.&#10;    def churchStore = System.getenv(&quot;CHURCHDAW_UPLOAD_STORE_FILE&quot;)&#10;    def churchStorePass = System.getenv(&quot;CHURCHDAW_UPLOAD_STORE_PASSWORD&quot;)&#10;    def churchKeyAlias = System.getenv(&quot;CHURCHDAW_UPLOAD_KEY_ALIAS&quot;)&#10;    def churchKeyPass = System.getenv(&quot;CHURCHDAW_UPLOAD_KEY_PASSWORD&quot;)&#10;    if (churchStore &amp;&amp; churchStorePass &amp;&amp; churchKeyAlias &amp;&amp; churchKeyPass) {&#10;        signingConfigs.create(&quot;churchDawWebRelease&quot;) {&#10;            storeFile(file(churchStore))&#10;            storePassword(churchStorePass)&#10;            keyAlias(churchKeyAlias)&#10;            keyPassword(churchKeyPass)&#10;            storeType(&quot;jks&quot;)&#10;        }&#10;        buildTypes.release.signingConfig = signingConfigs.churchDawWebRelease&#10;    } else {&#10;        buildTypes.release.signingConfig = null&#10;    }&#10;"
                   extraCompilerFlags="-funroll-loops"
                   androidManifestCustomXmlElements="&#10;&lt;manifest&gt;&#10;  &lt;!-- SEM ESTA LINHA O TECLADO NAO TOCA. O Android so entrega dispositivos&#10;       MIDI a um app que declara a feature; sem ela o MidiManager devolve&#10;       lista VAZIA, sem erro nenhum -- o app abre, o timbre carrega, e apertar&#10;       a tecla nao faz nada. Foi exatamente o sintoma no aparelho. --&gt;&#10;  &lt;uses-feature android:name=&quot;android.software.midi&quot; android:required=&quot;true&quot; /&gt;&#10;  &lt;uses-feature android:name=&quot;android.hardware.usb.host&quot; android:required=&quot;false&quot; /&gt;&#10;  &lt;!-- INTERNET faz o JUCE declarar multicast; torne Wi-Fi opcional para nao&#10;       excluir tablets Android com outra conectividade na Play Store. --&gt;&#10;  &lt;uses-feature android:name=&quot;android.hardware.wifi&quot; android:required=&quot;false&quot; /&gt;&#10;  &lt;!-- Libraries pode ocupar dezenas de GB e nunca deve entrar em Auto Backup.&#10;       O icone adaptativo e a fonte oficial do launcher; o roundIcon usa a mesma&#10;       arte para respeitar a mascara escolhida pelo fabricante. --&gt;&#10;  &lt;application android:allowBackup=&quot;false&quot; android:fullBackupContent=&quot;false&quot;&#10;               android:icon=&quot;@mipmap/ic_launcher&quot;&#10;               android:roundIcon=&quot;@mipmap/ic_launcher&quot; /&gt;&#10;  &lt;!-- MIDI Bluetooth LE: sem CONNECT/SCAN (API 31+) o MidiManager nao lista teclados BLE. --&gt;&#10;  &lt;uses-permission android:name=&quot;android.permission.BLUETOOTH&quot; android:maxSdkVersion=&quot;30&quot; /&gt;&#10;  &lt;uses-permission android:name=&quot;android.permission.BLUETOOTH_ADMIN&quot; android:maxSdkVersion=&quot;30&quot; /&gt;&#10;  &lt;uses-permission android:name=&quot;android.permission.BLUETOOTH_CONNECT&quot; /&gt;&#10;  &lt;uses-permission android:name=&quot;android.permission.BLUETOOTH_SCAN&quot; android:usesPermissionFlags=&quot;neverForLocation&quot; /&gt;&#10;  &lt;uses-feature android:name=&quot;android.hardware.bluetooth_le&quot; android:required=&quot;false&quot; /&gt;&#10;&lt;/manifest&gt;&#10;">
      <CONFIGURATIONS>
        <CONFIGURATION name="Debug"   isDebug="1" targetName="ChurchDAW"
                       androidArchitectures="arm64-v8a"
                       androidAdditionalDrawableResources="Packaging/AndroidResources/drawable-xxhdpi"/>
        <CONFIGURATION name="Release" isDebug="0" optimisation="5" targetName="ChurchDAW"
                       androidArchitectures="arm64-v8a"
                       androidAdditionalDrawableResources="Packaging/AndroidResources/drawable-xxhdpi"/>
      </CONFIGURATIONS>
      <MODULEPATHS>
        <MODULEPATH id="juce_core"                      path="JUCE/modules"/>
        <MODULEPATH id="juce_cryptography"              path="JUCE/modules"/>
        <MODULEPATH id="juce_events"                    path="JUCE/modules"/>
        <MODULEPATH id="juce_graphics"                  path="JUCE/modules"/>
        <MODULEPATH id="juce_data_structures"           path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_basics"                path="JUCE/modules"/>
        <MODULEPATH id="juce_gui_extra"                 path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_basics"              path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_devices"             path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_formats"             path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors"          path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_processors_headless" path="JUCE/modules"/>
        <MODULEPATH id="juce_audio_utils"               path="JUCE/modules"/>
        <MODULEPATH id="juce_dsp"                       path="JUCE/modules"/>
        <MODULEPATH id="juce_opengl"                    path="JUCE/modules"/>
      </MODULEPATHS>
    </ANDROIDSTUDIO>
  </EXPORTFORMATS>
  <MODULES>
    <MODULE id="juce_audio_basics"              showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_audio_devices"             showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_audio_formats"             showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_audio_processors"          showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_audio_processors_headless" showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_audio_utils"               showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_core"                      showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_cryptography"              showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_data_structures"           showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_dsp"                       showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_events"                    showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_graphics"                  showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_gui_basics"                showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_gui_extra"                 showAllCode="1" useLocalCopy="0"/>
    <MODULE id="juce_opengl"                    showAllCode="1" useLocalCopy="0"/>
  </MODULES>
  <JUCEOPTIONS JUCE_WEB_BROWSER="0"
               JUCE_USE_CURL="0"
               JUCE_PUSH_NOTIFICATIONS="0"
               JUCE_PLUGINHOST_VST3="0"
               JUCE_PLUGINHOST_AU="0"
               JUCE_USE_ANDROID_OBOE="1"
               JUCE_USE_ANDROID_OBOE_STABILIZED_CALLBACK="0"/>
  <LIVE_SETTINGS/>
</JUCERPROJECT>
