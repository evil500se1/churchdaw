    <GROUP id="ChDWast" name="Assets">
      <FILE id="astIco" name="icon.png"           compile="0" resource="1" file="Assets/icon.png"/>
      <FILE id="astAnd" name="icon-android.png"   compile="0" resource="1" file="Assets/icon-android.png"/>
      <FILE id="astAui" name="app-icon-512.png"   compile="0" resource="1" file="Packaging/PlayStore/app-icon-512.png"/>
      <FILE id="astLgo" name="logo_round.png"     compile="0" resource="1" file="Assets/logo_round.png"/>
      <FILE id="astGpi" name="glyph_piano.png"    compile="0" resource="1" file="Assets/glyph_piano.png"/>
      <FILE id="astGpa" name="glyph_pad.png"      compile="0" resource="1" file="Assets/glyph_pad.png"/>
      <FILE id="astGor" name="glyph_organ.png"    compile="0" resource="1" file="Assets/glyph_organ.png"/>
      <FILE id="astGst" name="glyph_strings.png"  compile="0" resource="1" file="Assets/glyph_strings.png"/>
      <FILE id="astGam" name="glyph_ambience.png" compile="0" resource="1" file="Assets/glyph_ambience.png"/>
      <FILE id="astGbe" name="glyph_bells.png"    compile="0" resource="1" file="Assets/glyph_bells.png"/>
      <FILE id="astGle" name="glyph_lead.png"     compile="0" resource="1" file="Assets/glyph_lead.png"/>
