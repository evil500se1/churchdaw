<?xml version="1.0" encoding="UTF-8"?>

<!-- Projeto do Projucer para os alvos MOVEIS (Android e, depois, iOS).

     Por que existe este arquivo, se o projeto ja tem CMakeLists.txt:
     o proprio JUCE avisa em docs/CMake API.md linha 6 que "Android targets are
     not currently supported" pelo sistema CMake. Entao Windows/macOS continuam
     saindo do CMake e o celular sai daqui. Os DOIS leem o mesmo Source/;
     nao ha copia de codigo.

     ATENCAO ao mexer no ANDROIDSTUDIO abaixo: o exemplo AudioPerformanceTest
     que vem no JUCE traz extraCompilerFlags com "-mfpu=neon -mfloat-abi=hard
     -mhard-float". Sao flags de ARM 32 BITS e o clang do NDK recusa em
     arm64-v8a, que e o que todo celular atual usa. Nao copie de la. -->

<JUCERPROJECT id="ChDW01" name="ChurchDAW" projectType="guiapp"
              version="1.5.9" bundleIdentifier="com.churchdaw.app"
              companyName="ChurchDAW" companyCopyright="ChurchDAW"
              useAppConfig="0" addUsingNamespaceToJuceHeader="0"
              jucerFormatVersion="1"
              defines="CHURCHDAW_HOSTS_PLUGINS=0&#10;JUCE_PLUGINHOST_VST3=0&#10;JUCE_PLUGINHOST_AU=0&#10;JUCE_WEB_BROWSER=0&#10;JUCE_USE_CURL=0&#10;JUCE_PUSH_NOTIFICATIONS=0&#10;JUCE_USE_ANDROID_OBOE=1&#10;JUCE_USE_ANDROID_OBOE_STABILIZED_CALLBACK=0">
  <MAINGROUP id="ChDWmg" name="ChurchDAW">
