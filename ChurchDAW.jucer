        <FILE id="org032" name="ScannerVibrato.cpp"          compile="1" resource="0" file="Source/ChurchOrgan/ScannerVibrato.cpp"/>
        <FILE id="org033" name="ScannerVibrato.h"            compile="0" resource="0" file="Source/ChurchOrgan/ScannerVibrato.h"/>
        <FILE id="org034" name="TonewheelBank.cpp"           compile="1" resource="0" file="Source/ChurchOrgan/TonewheelBank.cpp"/>
        <FILE id="org035" name="TonewheelBank.h"             compile="0" resource="0" file="Source/ChurchOrgan/TonewheelBank.h"/>
        <FILE id="org036" name="TonewheelCharacter.cpp"      compile="1" resource="0" file="Source/ChurchOrgan/TonewheelCharacter.cpp"/>
