# php -- BEGIN cPanel-generated handler, do not edit
# Defina o pacote “ea-php84” como a linguagem padrão de programação “PHP”.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^churchdaw\.com$ [NC]
    RewriteRule ^ https://churchdaw.com%{REQUEST_URI} [R=301,L]
</IfModule>

# BEGIN CHURCHDAW ACCOUNT OVERLAY
# Este bloco precisa ficar DEPOIS do redirect canonico para
# https://churchdaw.com (nunca montar o destino com %{HTTP_HOST}) e
# ANTES de qualquer outro RewriteRule da landing page. [END] impede que um
# catch-all posterior capture as rotas de conta. Nao substituir o restante.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Assets imutaveis sao preparados antes do corte e nunca sao reescritos
    # para o PHP nem para a landing page.
    RewriteRule ^account-assets/[A-Za-z0-9._-]{1,64}/(?:app\.css|app\.js)$ - [END]
    RewriteRule ^account-assets(?:/|$) - [R=404,END]

    # O front-controller e um detalhe interno; acesso direto deve falhar.
    RewriteCond %{THE_REQUEST} "\s/+churchdaw-account\.php(?:[/?\s])" [NC]
    RewriteRule ^churchdaw-account\.php(?:/.*)?$ - [R=404,END]

    RewriteRule ^api/v1(?:/.*)?$ churchdaw-account.php [QSA,END]
    RewriteRule ^(?:comprar|entrar|minha-conta|termos|politica-de-privacidade|compra/(?:sucesso|pendente|falhou)|verificar-email|redefinir-senha|esqueci-senha|reenviar-confirmacao)/?$ churchdaw-account.php [QSA,END]
</IfModule>

<Files "churchdaw-account.php">
    Require all granted
    LimitRequestBody 65536
</Files>

<FilesMatch "(^\.|composer\.(json|lock)$|.*\.(sql|log|ini|env|key|pem)$)">
    Require all denied
</FilesMatch>

<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(?:api/v1(?:/|$)|comprar/?$|entrar/?$|minha-conta/?$|termos/?$|politica-de-privacidade/?$|compra/(?:sucesso|pendente|falhou)/?$|verificar-email/?$|redefinir-senha/?$|esqueci-senha/?$|reenviar-confirmacao/?$)" CHURCHDAW_ACCOUNT_ROUTE=1
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set Cache-Control "no-store, max-age=0" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set X-Content-Type-Options "nosniff" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set X-Frame-Options "DENY" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set Referrer-Policy "no-referrer" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'self' https://www.mercadopago.com.br https://mercadopago.com.br; frame-ancestors 'none'" env=CHURCHDAW_ACCOUNT_ROUTE
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=CHURCHDAW_ACCOUNT_ROUTE
</IfModule>
# END CHURCHDAW ACCOUNT OVERLAY

RewriteCond %{HTTP_HOST} ^churchdaw\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.churchdaw\.com$
RewriteRule ^linknabio/?(.*)$ "https://olink.ai/churchdaw.com$1" [R=302,L]
