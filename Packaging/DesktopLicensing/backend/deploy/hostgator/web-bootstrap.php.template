<?php

declare(strict_types=1);

use ChurchDAW\Licensing\Config;
use ChurchDAW\Licensing\Database;

ini_set('display_errors', '0');
header_remove('X-Powered-By');
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store, max-age=0');
header('X-Content-Type-Options: nosniff');
header('X-Frame-Options: DENY');
header('Referrer-Policy: no-referrer');
header("Content-Security-Policy: default-src 'none'; frame-ancestors 'none'");

$reply = static function (int $status, array $body): never {
    http_response_code($status);
    echo json_encode($body, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR);
    exit;
};

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    $reply(404, ['ok' => false]);
}
if (($_SERVER['HTTPS'] ?? '') !== 'on') {
    $reply(400, ['ok' => false, 'error' => 'HTTPS_REQUIRED']);
}

$providedToken = (string) ($_SERVER['HTTP_X_CHURCHDAW_DEPLOY'] ?? '');
if ($providedToken === ''
    || !hash_equals('__TOKEN_HASH__', hash('sha256', $providedToken))) {
    usleep(random_int(120000, 280000));
    $reply(404, ['ok' => false]);
}

$release = '__RELEASE__';
$home = dirname(__DIR__);
$accountHome = $home . '/churchdaw';
$releaseRoot = $accountHome . '/releases/' . $release;
$sharedConfig = $accountHome . '/shared/config/local.php';
$releaseConfig = $releaseRoot . '/config/local.php';
$publicRoot = __DIR__;
$stagedPublic = $accountHome . '/deploy-public';

$action = (string) ($_SERVER['HTTP_X_CHURCHDAW_ACTION'] ?? '');
if ($action === '') {
    $input = json_decode((string) file_get_contents('php://input'), true);
    $action = is_array($input) ? (string) ($input['action'] ?? '') : '';
}
if ($action === 'cleanup') {
    $path = __FILE__;
    if (!@unlink($path)) {
        $reply(500, ['ok' => false, 'error' => 'CLEANUP_FAILED']);
    }
    $reply(200, ['ok' => true, 'removed' => true]);
}

$removeTree = static function (string $root): void {
    if (!is_dir($root)) {
        return;
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator(
            $root,
            FilesystemIterator::SKIP_DOTS
        ),
        RecursiveIteratorIterator::CHILD_FIRST
    );
    foreach ($iterator as $entry) {
        $path = $entry->getPathname();
        $entry->isDir() && !$entry->isLink() ? @rmdir($path) : @unlink($path);
    }
    @rmdir($root);
};

if ($action === 'stage' || $action === 'stage-file') {
    if (!class_exists(ZipArchive::class)
        || !preg_match('/^[A-Za-z0-9._-]{1,64}$/', $release)
        || is_dir($releaseRoot)) {
        $reply(409, ['ok' => false, 'error' => 'STAGE_NOT_AVAILABLE']);
    }
    $expectedHash = strtolower((string) ($action === 'stage-file'
        ? ($input['archive_sha256'] ?? '')
        : ($_SERVER['HTTP_X_CHURCHDAW_ARCHIVE_SHA256'] ?? '')));
    if (!preg_match('/^[a-f0-9]{64}$/', $expectedHash)) {
        $reply(400, ['ok' => false, 'error' => 'ARCHIVE_HASH_REQUIRED']);
    }
    if (!is_dir($accountHome)
        && !mkdir($accountHome, 0750, true)
        && !is_dir($accountHome)) {
        $reply(500, ['ok' => false, 'error' => 'ACCOUNT_HOME_FAILED']);
    }
    $archive = $accountHome . '/.upload-' . $release . '-'
        . bin2hex(random_bytes(8)) . '.zip';
    if ($action === 'stage-file') {
        $encryptedName = (string) ($input['encrypted_name'] ?? '');
        $iv = base64_decode((string) ($input['iv'] ?? ''), true);
        $mac = base64_decode((string) ($input['mac'] ?? ''), true);
        if (!preg_match('/^churchdaw-stage-[a-f0-9]{24}\.bin$/', $encryptedName)
            || !is_string($iv) || strlen($iv) !== 16
            || !is_string($mac) || strlen($mac) !== 32) {
            $reply(400, ['ok' => false, 'error' => 'ENCRYPTED_ARCHIVE_INVALID']);
        }
        $encryptedPath = $publicRoot . '/' . $encryptedName;
        $ciphertext = is_file($encryptedPath)
            ? file_get_contents($encryptedPath, false, null, 0, 8 * 1024 * 1024 + 1)
            : false;
        @unlink($encryptedPath);
        $encryptionKey = hash_hmac('sha256', 'archive-encryption', $providedToken, true);
        $macKey = hash_hmac('sha256', 'archive-authentication', $providedToken, true);
        if (!is_string($ciphertext)
            || strlen($ciphertext) > 8 * 1024 * 1024
            || !hash_equals($mac, hash_hmac('sha256', $iv . $ciphertext, $macKey, true))) {
            $reply(400, ['ok' => false, 'error' => 'ENCRYPTED_ARCHIVE_AUTH_FAILED']);
        }
        $plaintext = openssl_decrypt(
            $ciphertext,
            'aes-256-cbc',
            $encryptionKey,
            OPENSSL_RAW_DATA,
            $iv
        );
        if (!is_string($plaintext)
            || file_put_contents($archive, $plaintext, LOCK_EX) !== strlen($plaintext)) {
            @unlink($archive);
            $reply(400, ['ok' => false, 'error' => 'ENCRYPTED_ARCHIVE_DECRYPT_FAILED']);
        }
        $bytes = strlen($plaintext);
        sodium_memzero($plaintext);
        sodium_memzero($encryptionKey);
        sodium_memzero($macKey);
        unset($ciphertext);
    } else {
        $inputStream = fopen('php://input', 'rb');
        $outputStream = fopen($archive, 'xb');
        if (!is_resource($inputStream) || !is_resource($outputStream)) {
            $reply(500, ['ok' => false, 'error' => 'UPLOAD_OPEN_FAILED']);
        }
        $bytes = stream_copy_to_stream(
            $inputStream,
            $outputStream,
            8 * 1024 * 1024 + 1
        );
        fclose($inputStream);
        fclose($outputStream);
    }
    if (!is_int($bytes) || $bytes < 1024 || $bytes > 8 * 1024 * 1024
        || !hash_equals($expectedHash, hash_file('sha256', $archive))) {
        @unlink($archive);
        $reply(400, ['ok' => false, 'error' => 'ARCHIVE_INVALID']);
    }

    $stageRoot = $accountHome . '/.stage-' . $release . '-'
        . bin2hex(random_bytes(8));
    $zip = new ZipArchive();
    try {
        if ($zip->open($archive) !== true
            || (!mkdir($stageRoot, 0750, true) && !is_dir($stageRoot))) {
            throw new RuntimeException('Nao foi possivel abrir o pacote.');
        }
        $releasePrefix = 'churchdaw/releases/' . $release . '/';
        $allowedExact = [
            'churchdaw/shared/keys/churchdaw-license-private.pem',
            'churchdaw/deploy-public/account-assets.htaccess',
            'churchdaw/deploy-public/churchdaw-account.php',
            'churchdaw/deploy-public/churchdaw-routes.htaccess',
        ];
        for ($index = 0; $index < $zip->numFiles; ++$index) {
            $archiveName = $zip->getNameIndex($index);
            if (!is_string($archiveName) || $archiveName === ''
                || str_contains($archiveName, "\0")) {
                throw new RuntimeException('Caminho inseguro no pacote.');
            }
            // Compress-Archive do Windows grava separadores de caminho como
            // barras invertidas. Canonicalize antes de aplicar a allowlist e
            // as protecoes contra Zip Slip.
            $name = str_replace('\\', '/', $archiveName);
            if (str_starts_with($name, '/')
                || preg_match('~(^|/)\.\.(/|$)~', $name)) {
                throw new RuntimeException('Caminho inseguro no pacote.');
            }
            $isDirectory = str_ends_with($name, '/');
            $allowed = str_starts_with($name, $releasePrefix)
                || in_array(rtrim($name, '/'), $allowedExact, true)
                || ($isDirectory && (
                    str_starts_with($releasePrefix, $name)
                    || str_starts_with('churchdaw/shared/keys/', $name)
                    || str_starts_with('churchdaw/deploy-public/', $name)
                ));
            if (!$allowed) {
                continue;
            }
            $stat = $zip->statIndex($index);
            $mode = is_array($stat)
                ? (((int) ($stat['external_attributes'] ?? 0)) >> 16)
                : 0;
            if (($mode & 0170000) === 0120000) {
                throw new RuntimeException('Link simbolico recusado no pacote.');
            }
            $destination = $stageRoot . '/' . $name;
            if ($isDirectory) {
                if (!is_dir($destination)
                    && !mkdir($destination, 0750, true)
                    && !is_dir($destination)) {
                    throw new RuntimeException('Falha ao criar diretorio temporario.');
                }
                continue;
            }
            $directory = dirname($destination);
            if (!is_dir($directory)
                && !mkdir($directory, 0750, true)
                && !is_dir($directory)) {
                throw new RuntimeException('Falha ao criar pasta temporaria.');
            }
            $source = $zip->getStream($archiveName);
            $target = fopen($destination, 'xb');
            if (!is_resource($source) || !is_resource($target)
                || stream_copy_to_stream($source, $target) === false) {
                throw new RuntimeException('Falha ao extrair arquivo.');
            }
            fclose($source);
            fclose($target);
            chmod($destination, 0640);
        }
        $zip->close();

        $stagedRelease = $stageRoot . '/' . $releasePrefix;
        $stagedRelease = rtrim($stagedRelease, '/');
        if (!is_file($stagedRelease . '/src/autoload.php')
            || !is_file($stagedRelease . '/config/local.php')
            || !is_file($stagedRelease . '/migrations/016_woovi_checkout_plans.sql')) {
            throw new RuntimeException('Release incompleta no pacote.');
        }
        $releasesRoot = dirname($releaseRoot);
        if (!is_dir($releasesRoot)
            && !mkdir($releasesRoot, 0750, true)
            && !is_dir($releasesRoot)) {
            throw new RuntimeException('Falha ao criar pasta de releases.');
        }
        if (!rename($stagedRelease, $releaseRoot)) {
            throw new RuntimeException('Falha ao promover release privada.');
        }
        chmod($releaseRoot . '/config/local.php', 0600);

        $stagedKey = $stageRoot
            . '/churchdaw/shared/keys/churchdaw-license-private.pem';
        $sharedKey = $accountHome
            . '/shared/keys/churchdaw-license-private.pem';
        if (!is_file($stagedKey)) {
            throw new RuntimeException('Chave de assinatura ausente.');
        }
        if (is_file($sharedKey)) {
            if (!hash_equals(hash_file('sha256', $stagedKey), hash_file('sha256', $sharedKey))) {
                throw new RuntimeException('Chave de assinatura divergente.');
            }
        } else {
            if (!is_dir(dirname($sharedKey))) {
                mkdir(dirname($sharedKey), 0750, true);
            }
            if (!rename($stagedKey, $sharedKey)) {
                throw new RuntimeException('Falha ao instalar chave de assinatura.');
            }
        }
        chmod($sharedKey, 0600);

        $publicSource = $stageRoot . '/churchdaw/deploy-public';
        if (!is_dir($stagedPublic)) {
            mkdir($stagedPublic, 0750, true);
        }
        foreach ($allowedExact as $allowedFile) {
            if (!str_starts_with($allowedFile, 'churchdaw/deploy-public/')) {
                continue;
            }
            $name = basename($allowedFile);
            $source = $publicSource . '/' . $name;
            $temporary = $stagedPublic . '/.' . $name . '.next-'
                . bin2hex(random_bytes(6));
            if (!is_file($source) || !copy($source, $temporary)
                || !rename($temporary, $stagedPublic . '/' . $name)) {
                @unlink($temporary);
                throw new RuntimeException('Falha ao preparar overlay publico.');
            }
        }
        $removeTree($stageRoot);
        @unlink($archive);
        $reply(200, [
            'ok' => true,
            'release' => $release,
            'staged' => true,
            'archive_sha256' => $expectedHash,
        ]);
    } catch (Throwable $error) {
        if ($zip->status === ZipArchive::ER_OK) {
            $zip->close();
        }
        $removeTree($stageRoot);
        @unlink($archive);
        error_log('ChurchDAW stage failed: ' . $error->getMessage());
        $reply(500, [
            'ok' => false,
            'error' => 'STAGE_FAILED',
            'message' => $error->getMessage(),
        ]);
    }
}
if ($action !== 'activate') {
    $reply(400, ['ok' => false, 'error' => 'INVALID_ACTION']);
}

$hardenPrivateTree = static function (string $root): void {
    if (!is_dir($root)) {
        return;
    }
    chmod($root, 0750);
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator(
            $root,
            FilesystemIterator::SKIP_DOTS
        ),
        RecursiveIteratorIterator::SELF_FIRST
    );
    foreach ($iterator as $entry) {
        if ($entry->isLink()) {
            continue;
        }
        chmod($entry->getPathname(), $entry->isDir() ? 0750 : 0640);
    }
};

$atomicCopy = static function (string $source, string $destination): void {
    if (!is_file($source) || is_link($source)) {
        throw new RuntimeException('Arquivo de origem ausente ou inseguro.');
    }
    $directory = dirname($destination);
    if (!is_dir($directory) && !mkdir($directory, 0750, true) && !is_dir($directory)) {
        throw new RuntimeException('Nao foi possivel criar diretorio publico.');
    }
    $temporary = $destination . '.next-' . bin2hex(random_bytes(8));
    if (!copy($source, $temporary)) {
        throw new RuntimeException('Nao foi possivel preparar arquivo publico.');
    }
    chmod($temporary, 0644);
    if (!rename($temporary, $destination)) {
        @unlink($temporary);
        throw new RuntimeException('Nao foi possivel promover arquivo publico.');
    }
};

try {
    // ZIPs montados no Windows nao preservam os bits de execucao dos
    // diretorios. Normalize somente a arvore privada desta release antes do
    // preflight; config e chave recebem permissoes ainda mais restritas abaixo.
    foreach ([
        $accountHome,
        $accountHome . '/releases',
        $releaseRoot,
        $sharedConfig !== '' ? dirname(dirname($sharedConfig)) : '',
        $stagedPublic,
    ] as $privateTree) {
        if ($privateTree !== '') {
            $hardenPrivateTree($privateTree);
        }
    }
    if (is_file($sharedConfig)) {
        chmod($sharedConfig, 0600);
    }
    $sharedKey = $accountHome . '/shared/keys/churchdaw-license-private.pem';
    if (is_file($sharedKey)) {
        chmod($sharedKey, 0600);
    }

    if (!preg_match('/^[A-Za-z0-9._-]{1,64}$/', $release)
        || !is_dir($releaseRoot)
        || !is_file($releaseRoot . '/src/autoload.php')
        || (!is_file($releaseConfig) && !is_file($sharedConfig))) {
        throw new RuntimeException('Release privada incompleta.');
    }

    if (is_link($releaseConfig)) {
        if (!is_file($sharedConfig)
            || realpath($releaseConfig) !== realpath($sharedConfig)) {
            throw new RuntimeException('Link de configuracao inesperado.');
        }
    } elseif (!is_file($releaseConfig)) {
        throw new RuntimeException('Configuracao da release ausente.');
    }
    chmod($releaseConfig, 0600);

    require $releaseRoot . '/src/autoload.php';
    $config = Config::load($releaseRoot);
    $config->assertRuntimeReady();
    $checkoutEnabled = $config->bool('checkout.enabled');
    if (!hash_equals($release, $config->string('app.release'))
        || ($checkoutEnabled
            && $config->string('checkout.provider') !== 'woovi')) {
        throw new RuntimeException('Preflight da release recusado.');
    }

    $database = new Database($config);
    $pdo = $database->pdo();
    $serverVersion = trim((string) $pdo->query('SELECT VERSION()')->fetchColumn());
    $isMariaDb = stripos($serverVersion, 'mariadb') !== false;
    preg_match_all(
        '/(?<![0-9])([0-9]+\.[0-9]+\.[0-9]+)(?![0-9])/',
        $serverVersion,
        $versionMatches
    );
    $detectedVersions = $versionMatches[1] ?? [];
    $parsedVersion = $isMariaDb
        ? end($detectedVersions)
        : ($detectedVersions[0] ?? false);
    $minimumVersion = $isMariaDb ? '10.6.0' : '5.7.44';
    if (!is_string($parsedVersion)
        || version_compare($parsedVersion, $minimumVersion, '<')) {
        throw new RuntimeException('Versao do banco nao suportada.');
    }

    $pdo->exec(
        'CREATE TABLE IF NOT EXISTS schema_migrations (
            version VARCHAR(64) PRIMARY KEY,
            applied_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)
         ) ENGINE=InnoDB
           DEFAULT CHARSET=utf8mb4
           COLLATE=utf8mb4_unicode_ci
           ROW_FORMAT=DYNAMIC'
    );
    $lockName = 'churchdaw_desktop_licensing_migrations';
    $lock = $pdo->prepare('SELECT GET_LOCK(:name, 15)');
    $lock->execute(['name' => $lockName]);
    if ((int) $lock->fetchColumn() !== 1) {
        throw new RuntimeException('Outra migracao esta em andamento.');
    }
    try {
        $migrationFiles = glob($releaseRoot . '/migrations/*.sql') ?: [];
        sort($migrationFiles, SORT_STRING);
        foreach ($migrationFiles as $migrationFile) {
            $version = basename($migrationFile);
            $check = $pdo->prepare(
                'SELECT COUNT(*) FROM schema_migrations WHERE version = :version'
            );
            $check->execute(['version' => $version]);
            if ((int) $check->fetchColumn() > 0) {
                continue;
            }
            $sql = file_get_contents($migrationFile);
            if (!is_string($sql) || trim($sql) === '') {
                throw new RuntimeException('Migration vazia.');
            }
            $pdo->exec($sql);
            $insert = $pdo->prepare(
                'INSERT INTO schema_migrations (version) VALUES (:version)'
            );
            $insert->execute(['version' => $version]);
        }
        $product = $pdo->prepare(
            "INSERT INTO products (code, name, currency, price_cents, status)
             VALUES (:code, :name, :currency, :price_cents, 'active')
             ON DUPLICATE KEY UPDATE
                name = VALUES(name),
                currency = VALUES(currency),
                price_cents = VALUES(price_cents),
                status = 'active'"
        );
        $product->execute([
            'code' => $config->string('product.code'),
            'name' => $config->string('product.name'),
            'currency' => $config->string('product.currency'),
            'price_cents' => $config->int('product.price_cents'),
        ]);
    } finally {
        $unlock = $pdo->prepare('SELECT RELEASE_LOCK(:name)');
        $unlock->execute(['name' => $lockName]);
    }

    $assetSource = $releaseRoot . '/public/account-assets';
    foreach (['app.css', 'app.js'] as $asset) {
        if (!is_file($assetSource . '/' . $asset)) {
            throw new RuntimeException('Asset da conta ausente.');
        }
    }
    $assetDestination = $publicRoot . '/account-assets/' . $release;
    if (!is_dir($assetDestination)) {
        $assetTemporary = $publicRoot . '/account-assets/.'
            . $release . '.next-' . bin2hex(random_bytes(8));
        if (!mkdir($assetTemporary, 0755, true) && !is_dir($assetTemporary)) {
            throw new RuntimeException('Nao foi possivel preparar assets.');
        }
        foreach (['app.css', 'app.js'] as $asset) {
            if (!copy($assetSource . '/' . $asset, $assetTemporary . '/' . $asset)) {
                throw new RuntimeException('Falha ao copiar asset.');
            }
            chmod($assetTemporary . '/' . $asset, 0644);
        }
        if (!rename($assetTemporary, $assetDestination)) {
            throw new RuntimeException('Falha ao promover assets.');
        }
    } else {
        foreach (['app.css', 'app.js'] as $asset) {
            $sourceHash = hash_file('sha256', $assetSource . '/' . $asset);
            $destinationHash = hash_file('sha256', $assetDestination . '/' . $asset);
            if (!is_string($sourceHash)
                || !is_string($destinationHash)
                || !hash_equals($sourceHash, $destinationHash)) {
                throw new RuntimeException('Release publica ja existe com bytes divergentes.');
            }
        }
    }

    $atomicCopy(
        $stagedPublic . '/account-assets.htaccess',
        $publicRoot . '/account-assets/.htaccess'
    );
    $atomicCopy(
        $stagedPublic . '/churchdaw-account.php',
        $publicRoot . '/churchdaw-account.php'
    );

    $current = $accountHome . '/current';
    if (file_exists($current) && !is_link($current)) {
        throw new RuntimeException('current nao e um link simbolico.');
    }
    $next = $accountHome . '/.current-next-' . bin2hex(random_bytes(8));
    if (!symlink($releaseRoot, $next)) {
        throw new RuntimeException('Nao foi possivel preparar current.');
    }
    if (!rename($next, $current)) {
        @unlink($next);
        throw new RuntimeException('Nao foi possivel ativar current.');
    }

    $applied = $pdo->query(
        'SELECT version FROM schema_migrations ORDER BY version'
    )->fetchAll(PDO::FETCH_COLUMN);
    $reply(200, [
        'ok' => true,
        'release' => $release,
        'checkout_enabled' => $checkoutEnabled,
        'database' => $isMariaDb ? 'MariaDB ' . $parsedVersion : 'MySQL ' . $parsedVersion,
        'migrations' => $applied,
        'assets_sha256' => [
            'app.css' => hash_file('sha256', $assetSource . '/app.css'),
            'app.js' => hash_file('sha256', $assetSource . '/app.js'),
        ],
    ]);
} catch (Throwable $error) {
    error_log('ChurchDAW deploy failed: ' . $error->getMessage());
    $reply(500, [
        'ok' => false,
        'error' => 'DEPLOY_FAILED',
        'message' => $error->getMessage(),
    ]);
}
